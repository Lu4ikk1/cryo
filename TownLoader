--==============================================================
-- Cryo Loader: AC bypass (старый способ) + preloader + загрузка
--==============================================================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- URL основного скрипта
local MAIN_URL = "https://raw.githubusercontent.com/Lu4ikk1/cryo/refs/heads/main/TOWNCRYO"

--==============================================================
-- 1. AC BYPASS (старый способ: coroutine.yield + разовый скан)
--==============================================================
task.spawn(function()
    task.wait(0.5)
    local detectedFunc
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" then
            local ok, d = pcall(rawget, v, "Detected")
            if ok and type(d) == "function" then
                detectedFunc = d
                break
            end
        end
    end
    if detectedFunc then
        pcall(function()
            hookfunction(detectedFunc, function(...)
                coroutine.yield()
            end)
        end)
    end
    task.wait()
    local kills = {}
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" then
            local ok, k = pcall(rawget, v, "Kill")
            if ok and type(k) == "function" then
                table.insert(kills, k)
            end
        end
    end
    for _, k in ipairs(kills) do
        pcall(function()
            hookfunction(k, function(...) end)
        end)
        task.wait()
    end
end)

--==============================================================
-- 2. PRELOADER
--==============================================================
local ACCENT = Color3.fromRGB(120, 170, 255)
local BG_DARK = Color3.fromRGB(18, 18, 24)

local preloader = Instance.new("ScreenGui")
preloader.Name = "CryoPreloader"
preloader.ResetOnSpawn = false
preloader.DisplayOrder = 9999
preloader.IgnoreGuiInset = true
preloader.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 90)
frame.Position = UDim2.new(0.5, -130, 0.5, -45)
frame.BackgroundColor3 = BG_DARK
frame.BorderSizePixel = 0
frame.Parent = preloader
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

local stroke = Instance.new("UIStroke")
stroke.Color = ACCENT
stroke.Thickness = 2
stroke.Transparency = 0.3
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -24, 0, 30)
title.Position = UDim2.new(0, 12, 0, 16)
title.BackgroundTransparency = 1
title.Text = "Script is loading"
title.Font = Enum.Font.GothamBlack
title.TextSize = 18
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextXAlignment = Enum.TextXAlignment.Center
title.Parent = frame

local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, -40, 0, 6)
barBg.Position = UDim2.new(0, 20, 0, 60)
barBg.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
barBg.BorderSizePixel = 0
barBg.Parent = frame
Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = ACCENT
barFill.BorderSizePixel = 0
barFill.Parent = barBg
Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

TweenService:Create(barFill, TweenInfo.new(0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
    Size = UDim2.new(1, 0, 1, 0)
}):Play()

local function fadeOut()
    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
    for _, child in ipairs(frame:GetDescendants()) do
        if child:IsA("TextLabel") then
            TweenService:Create(child, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        elseif child:IsA("Frame") then
            TweenService:Create(child, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        elseif child:IsA("UIStroke") then
            TweenService:Create(child, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        end
    end
    task.wait(0.4)
    if preloader and preloader.Parent then
        preloader:Destroy()
    end
end

--==============================================================
-- 3. ЗАГРУЗКА ОСНОВНОГО СКРИПТА
--==============================================================
task.spawn(function()
    local ok, err = pcall(function()
        local code = game:HttpGet(MAIN_URL)
        local fn, loadErr = loadstring(code)
        if not fn then
            error("loadstring failed: " .. tostring(loadErr))
        end
        fn()
    end)

    if not ok then
        warn("[Cryo] Ошибка загрузки основного скрипта:", err)
        title.Text = "Load error"
        title.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

--==============================================================
-- 4. ЖДЁМ СОЗДАНИЯ UI (до 10 сек)
--==============================================================
local timeout = tick() + 10
while not _G.CryoLibScreenGui and tick() < timeout do
    task.wait(0.1)
end

if not _G.CryoLibScreenGui then
    title.Text = "UI not found"
    title.TextColor3 = Color3.fromRGB(255, 80, 80)
    task.wait(2)
end

task.wait(0.5)

--==============================================================
-- 5. СКРЫТЬ ПРЕЛОАДЕР + ПОКАЗАТЬ UI
--==============================================================
fadeOut()

if _G.CryoLibScreenGui then
    _G.CryoLibScreenGui.Enabled = true
end

return {
    Hide = fadeOut,
    Destroy = function()
        if preloader and preloader.Parent then
            preloader:Destroy()
        end
    end
}
