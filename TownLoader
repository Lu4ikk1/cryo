
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local MAIN_URL = "https://raw.githubusercontent.com/Lu4ikk1/cryo/refs/heads/main/TOWNCRYO"

task.spawn(function()
    local hooked = {}
    local lastGcCount = 0
    local lastScanAt = tick()

    local function scan()
        local gc = getgc(true)
        if type(gc) ~= "table" then return end

        for _, v in pairs(gc) do
            if type(v) ~= "table" then continue end

            local detected = rawget(v, "Detected")
            if type(detected) == "function" and not hooked[detected] then
                hooked[detected] = true
                pcall(hookfunction, detected, function() return end)
            end

            local kill = rawget(v, "Kill")
            if type(kill) == "function" and not hooked[kill] then
                hooked[kill] = true
                pcall(hookfunction, kill, function() return end)
            end
        end

        lastGcCount = #gc
    end

    scan()

    while true do
        task.wait(0.5)
        local gc = getgc(true)
        local count = type(gc) == "table" and #gc or 0

        if count > lastGcCount or tick() - lastScanAt > 5 then
            scan()
            lastScanAt = tick()
        end
    end
end)

local ACCENT = Color3.fromRGB(120, 170, 255)
local BG_DARK = Color3.fromRGB(18, 18, 24)

local preloader = Instance.new("ScreenGui")
preloader.Name = "CryoPreloader"
preloader.ResetOnSpawn = false
preloader.DisplayOrder = 9999
preloader.IgnoreGuiInset = true
preloader.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 90)
frame.Position = UDim2.new(0.5, -130, 0.5, -45)
frame.BackgroundColor3 = BG_DARK
frame.BorderSizePixel = 0
frame.Parent = preloader
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

local stroke = Instance.new("UIStroke")
stroke.Color = ACCENT
stroke.Thickness = 2
stroke.Transparency = 0.3
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -24, 0, 30)
title.Position = UDim2.new(0, 12, 0, 16)
title.BackgroundTransparency = 1
title.Text = "Script is loading"
title.Font = Enum.Font.GothamBlack
title.TextSize = 18
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextXAlignment = Enum.TextXAlignment.Center
title.Parent = frame

local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, -40, 0, 6)
barBg.Position = UDim2.new(0, 20, 0, 60)
barBg.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
barBg.BorderSizePixel = 0
barBg.Parent = frame
Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = ACCENT
barFill.BorderSizePixel = 0
barFill.Parent = barBg
Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

TweenService:Create(barFill, TweenInfo.new(0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
    Size = UDim2.new(1, 0, 1, 0)
}):Play()

local function fadeOut()
    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
    for _, child in ipairs(frame:GetDescendants()) do
        if child:IsA("TextLabel") then
            TweenService:Create(child, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        elseif child:IsA("Frame") then
            TweenService:Create(child, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
        elseif child:IsA("UIStroke") then
            TweenService:Create(child, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        end
    end
    task.wait(0.4)
    preloader:Destroy()
end

task.wait(0.3) -- даём прелоадеру отрисоваться

local ok, err = pcall(function()
    local code = game:HttpGet(MAIN_URL)
    local fn, loadErr = loadstring(code)
    if not fn then
        error("loadstring failed: " .. tostring(loadErr))
    end
    fn()
end)

if not ok then
    warn("[Cryo] Ошибка загрузки основного скрипта:", err)
    title.Text = "Load error"
    title.TextColor3 = Color3.fromRGB(255, 80, 80)
    task.wait(2)
end

task.wait(0.5)
fadeOut()

if _G.CryoLibScreenGui then
    _G.CryoLibScreenGui.Enabled = true
end

return {
    Hide = fadeOut,
    Destroy = function() preloader:Destroy() end
}
