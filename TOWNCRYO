--==============================================================
-- SILENT AIM
--==============================================================
local silentTarget

local function getSilentTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end

    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local closestDist = Settings.SilentAimFOV
    local closestPart
    local mousePos = UserInputService:GetMouseLocation()
    local camPos = cam.CFrame.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Settings.SilentAimIgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end

        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(Settings.SilentAimPart)
        if not part then continue end

        if Settings.SilentAimWallCheck then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {myChar, cam}
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.IgnoreWater = true

            local dir = part.Position - camPos
            local result = workspace:Raycast(camPos, dir, params)
            if result and result.Instance and not result.Instance:IsDescendantOf(char) then
                if (result.Position - camPos).Magnitude < dir.Magnitude - 1 then
                    continue
                end
            end
        end

        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestPart = part
        end
    end
    return closestPart
end

RunService.RenderStepped:Connect(function()
    if Settings.SilentAim then
        local ok, target = pcall(getSilentTarget)
        silentTarget = ok and target or nil
    else
        silentTarget = nil
    end

    if silentTarget then
        local name = silentTarget.Parent and silentTarget.Parent.Name or "?"
        silentLabel.Text = ("SA Target: %s (%s)"):format(name, silentTarget.Name)
    else
        silentLabel.Text = "SA Target: none"
    end
end)

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()

    if method == "Raycast" and self == Workspace
        and Settings.SilentAim and silentTarget and silentTarget.Parent then
        local args = {...}
        local origin = args[1]
        local direction = args[2]
        if origin and direction then
            args[2] = (silentTarget.Position - origin).Unit * direction.Magnitude
            return oldNamecall(self, unpack(args))
        end
    end

    return oldNamecall(self, ...)
end))

