local espActive = false
local espConnections = {}

local function clearESPFor(character)
    if not character then return end
    local hl = character:FindFirstChild("ESP_HL")
    if hl then hl:Destroy() end
    local head = character:FindFirstChild("Head")
    if head then
        local bb = head:FindFirstChild("ESP_BB")
        if bb then bb:Destroy() end
    end
end

local function espLoop()
    while espActive do
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if not head or not hum or hum.Health <= 0 then
                        clearESPFor(plr.Character)
                        continue
                    end

                    local hl = plr.Character:FindFirstChild("ESP_HL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "ESP_HL"
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = plr.Character
                    end
                    hl.Adornee = plr.Character
                    hl.FillColor = Settings.ESPColor
                    hl.OutlineColor = Settings.ESPColor

                    local showInfo = Settings.ESPShowName or Settings.ESPShowHP or Settings.ESPShowDistance
                    local bb = head:FindFirstChild("ESP_BB")

                    if showInfo then
                        if not bb then
                            bb = Instance.new("BillboardGui")
                            bb.Name = "ESP_BB"
                            bb.Size = UDim2.new(0, 150, 0, 50)
                            bb.StudsOffset = Vector3.new(0, 3, 0)
                            bb.AlwaysOnTop = true
                            bb.Parent = head

                            local label = Instance.new("TextLabel")
                            label.Name = "ESP_Text"
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = Color3.fromRGB(255, 255, 255)
                            label.TextSize = 12
                            label.Font = Enum.Font.GothamBold
                            label.TextStrokeTransparency = 0.5
                            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            label.Parent = bb
                        end

                        local label = bb:FindFirstChild("ESP_Text")
                        if label then
                            local parts = {}
                            if Settings.ESPShowName then table.insert(parts, plr.Name) end
                            if Settings.ESPShowHP then
                                table.insert(parts, math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. " HP")
                            end
                            if Settings.ESPShowDistance and LocalPlayer.Character then
                                local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if root then
                                    table.insert(parts, math.floor((head.Position - root.Position).Magnitude) .. "m")
                                end
                            end
                            label.Text = table.concat(parts, "\n")
                        end
                    elseif bb then
                        bb:Destroy()
                    end
                end
            end
        end)
        task.wait(0.2)
    end
end

function enableESP()
    espActive = true
    for _, conn in ipairs(espConnections) do pcall(function() conn:Disconnect() end) end
    espConnections = {}

    table.insert(espConnections, Players.PlayerRemoving:Connect(function(plr)
        clearESPFor(plr.Character)
    end))

    task.spawn(espLoop)
end

function disableESP()
    espActive = false
    for _, conn in ipairs(espConnections) do pcall(function() conn:Disconnect() end) end
    espConnections = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        clearESPFor(plr.Character)
    end
end

